# =============================================================================
# FieldNode — .dockerignore
#
# Exclui artefatos locais desnecessários para o build da imagem Docker.
# ATENÇÃO: media/models/ é intencionalmente mantido porque contém
# isolation_forest_v1.pkl (api_tcc/ia/modelos/) necessário na imagem.
# Os .pkl gerados em runtime (media/models/*.pkl) são montados via volume.
# =============================================================================

# Controle de versão
.git/
.gitignore

# Segredos — nunca entram na imagem
.env
.env.*
.env.docker
.env.local

# Ambientes virtuais Python
.venv/
venv/

# Cache Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Cache de testes
.pytest_cache/
.coverage
htmlcov/

# Frontend (não faz parte da imagem do backend)
frontend-next/
frontend/
frontend_antigo/
node_modules/
.next/

# Banco local de desenvolvimento
db.sqlite3
*.sqlite3.bak
*.sqlite3.pre-*.bak

# Logs
*.log
fieldnode.log
fieldnode_demo_evidence.log
fieldnode_docker.log

# Arquivos de evidência/screenshots de desenvolvimento
*.png
*.html
debug_*.txt
debug_*.html

# Arquivos estáticos gerados (serão gerados por collectstatic no container)
staticfiles/

# IDE e sistema
.vscode/
.idea/
.DS_Store
Thumbs.db

# Kiro/worktrees locais
.kiro/
.kilo/
.nanocoder/

# Documentação de artefatos de desenvolvimento
CHECKLIST_*.md
BLOCO_*.md
DEMO.md
faq_banca.md
evidence_*.png
admin_*.png
debug_*.png
