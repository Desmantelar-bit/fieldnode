# =============================================================================
# FieldNode — .env.example
#
# Copie para .env e preencha os valores antes de iniciar.
# NUNCA commite o .env real — ele está no .gitignore.
#
# Variáveis marcadas com [OBRIGATÓRIO] não possuem padrão seguro.
# Variáveis marcadas com [DOCKER] precisam de valor específico no ambiente
# containerizado (já pré-configuradas no docker-compose.yml como override,
# mas documentadas aqui para execução local sem Docker).
# =============================================================================

# ── Django ────────────────────────────────────────────────────────────────────

# [OBRIGATÓRIO] Chave secreta Django. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-secret-key-antes-de-usar

# Modo debug. Use True apenas em desenvolvimento local. False em Docker/produção.
DEBUG=False

# [OBRIGATÓRIO] API Key usada nos headers X-API-Key de ingestão de telemetria.
# Use um UUID real em produção: python -c "import uuid; print(uuid.uuid4())"
FIELDNODE_API_KEY=00000000-0000-4000-8000-000000000000

# Modo demonstração. Quando True, leituras públicas retornam apenas máquinas
# marcadas como is_demo=True. Não substitui autorização real.
DEMO_MODE=False

# Chave do Gemini (usada apenas na camada de explicação LLM do backend).
# Deixe vazio para desabilitar a feature de explicação via LLM.
GEMINI_API_KEY=

# ── Hosts e CORS ──────────────────────────────────────────────────────────────

# [DOCKER] Para o ambiente Docker, inclua "web" e "localhost".
# Exemplo local: 127.0.0.1,localhost
# Exemplo Docker: 127.0.0.1,localhost,web
ALLOWED_HOSTS=127.0.0.1,localhost,web

# Origens CORS permitidas (separadas por vírgula).
# Inclua a origem real do browser que acessa o backend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Permite envio de cookies/auth nas requisições cross-origin.
CORS_ALLOW_CREDENTIALS=True

# ── SSL / HTTPS ───────────────────────────────────────────────────────────────

# Ativa SECURE_SSL_REDIRECT. Mantenha False em Docker local sem proxy HTTPS.
# Ative somente quando houver um proxy HTTPS real na frente (nginx, ALB, etc).
SECURE_SSL=False

# ── Banco de dados ────────────────────────────────────────────────────────────

# True: usa SQLite (sem MySQL necessário) — apenas para desenvolvimento local.
# False: usa MySQL — obrigatório para o ambiente Docker e validação real.
# O docker-compose.yml força USE_SQLITE=False via override de environment.
USE_SQLITE=False

# Nome do banco MySQL
DB_NAME=fieldnode_db

# Usuário MySQL (não use root em produção)
DB_USER=fieldnode_user

# [OBRIGATÓRIO] Senha do usuário MySQL
DB_PASSWORD=troque-esta-senha-db

# Senha root usada somente pelo serviço db. Se vazia/ausente, usa DB_PASSWORD.
DB_ROOT_PASSWORD=troque-esta-senha-root

# [DOCKER] Host do banco. "db" dentro do Docker, "127.0.0.1" local.
# O docker-compose.yml já define DB_HOST=db via override de environment.
DB_HOST=127.0.0.1

# Porta do MySQL
DB_PORT=3306

# ── MQTT ──────────────────────────────────────────────────────────────────────

# [DOCKER] Host do broker MQTT. "mosquitto" dentro do Docker, "localhost" local.
# O docker-compose.yml já define MQTT_BROKER=mosquitto via override.
MQTT_BROKER=localhost
MQTT_PORT=1883

# ── Frontend Next.js ──────────────────────────────────────────────────────────

# URL da API usada pelo browser (lado cliente). Deve ser acessível do browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# URL da API usada pelo servidor Next.js (SSR/rewrites). Dentro do Docker,
# aponta para o serviço "web" pelo nome interno do Compose.
# [DOCKER] Use http://web:8000/api dentro do Docker.
FIELDNODE_SERVER_API_URL=http://127.0.0.1:8000/api

# Não use NEXT_PUBLIC_ para segredos — qualquer variável NEXT_PUBLIC_* vai
# para o bundle do browser e é visível para qualquer pessoa.
NEXT_PUBLIC_FIELDNODE_SERVER_API_URL=http://127.0.0.1:8000/api

# ── Scripts locais (não usados dentro do Docker) ──────────────────────────────

FIELDNODE_API_HOST=http://127.0.0.1:8000
FIELDNODE_API_URL=http://127.0.0.1:8000/api
FIELDNODE_FRONTEND_URL=http://127.0.0.1:3000
