{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FieldNode telemetry v1.2",
  "type": "object",
  "required": ["maquina_id", "temperatura", "vibracao"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.2"},
    "maquina_id": {"type": "string", "minLength": 1},
    "temperatura": {"type": "number", "minimum": 0, "maximum": 150},
    "vibracao": {"type": "number", "minimum": 0, "maximum": 10},
    "vibracao_unit": {"type": "string", "enum": ["indice_0_10", "g"]},
    "vibracao_rms_g": {"$ref": "#/$defs/axis_features"},
    "vibracao_pico_g": {"$ref": "#/$defs/axis_features"},
    "vibracao_curtose": {"$ref": "#/$defs/axis_features"},
    "rpm": {"type": ["integer", "null"], "minimum": 0, "maximum": 5000, "description": "RPM medido; ausente/null quando o sensor não estiver disponível. Nunca usar zero como marcador de ausência."},
    "gps_fix": {"type": ["boolean", "null"]},
    "gps_hdop": {"type": ["number", "null"], "minimum": 0, "maximum": 99.9},
    "velocidade_kmh": {"type": ["number", "null"], "minimum": 0, "maximum": 300},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "time_source": {"type": "string", "enum": ["rtc", "gateway", "ntp", "unsynced"]},
    "timestamp": {"type": "string"},
    "event_time": {"type": "string"},
    "boot_id": {"type": "string", "format": "uuid"},
    "uptime_ms": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "axis_features": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "z": {"type": "number", "minimum": 0}
      }
    }
  }
}
